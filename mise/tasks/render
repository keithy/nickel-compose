#!/usr/bin/env bash
#MISE description="Render config.ncl to compose.yaml (use with -- config=path out=path)"
#MISE raw=true

# Find nickel-compose.sh relative to this task file.
TASK_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$TASK_DIR/../.." && pwd)"
NC_SH="$ROOT/nickel-compose.sh"

# Default config: ./config.ncl if present, else the bundled example.
if [[ -z "${config:-}" ]]; then
  if [[ -f "./config.ncl" ]]; then
    config="./config.ncl"
  else
    config="$ROOT/examples/podclaws/config.ncl"
  fi
fi

# Forward --out as a flag to nickel-compose.sh use.
if [[ -n "${out:-}" ]]; then
  "$NC_SH" use "$config" --out "$out"
else
  "$NC_SH" use "$config"
fi
